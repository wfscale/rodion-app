# ---------------------------------------------------------------------------
# SUPABASE — обязательно
# Supabase → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role ключ. Нужен только для синхронизации с Google Sheets
# (сервер читает refresh_token, который скрыт от браузера).
# НИКОГДА не добавлять префикс NEXT_PUBLIC_ к этому ключу.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# GOOGLE SHEETS — необязательно.
# Без этих переменных приложение работает полностью, просто без синхронизации.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
